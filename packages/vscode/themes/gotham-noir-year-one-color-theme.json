  "semanticTokenColors": {
    "namespace": "#F0C946",
    "class": "#F0C946",
    "interface": "#F0C946",
    "struct": "#F0C946",
    "enum": "#F0C946",
    "type": "#F0C946",
    "typeParameter": "#E0A4B8",
    "enumMember": "#E29754",
    "function": "#74AEEB",
    "method": "#74AEEB",
    "macro": "#68C5CE",
    "decorator": "#B695E8",
    "variable": "#D8D6CF",
    "variable.readonly": "#E29754",
    "variable.defaultLibrary": "#68C5CE",
    "parameter": "#E29754",
    "property": "#68C5CE",
    "property.readonly": "#E29754",
    "keyword": "#B695E8",
    "string": "#63C794",
    "number": "#E29754",
    "regexp": "#68C5CE",
    "operator": "#68C5CE",
    "comment": {
      "foreground": "#878D96",
      "italic": true
    }
  },
  "tokenColors": [
    {
      "name": "Gotham Fog \u2014 Comments & Docstrings",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.quoted.docstring.multi",
        "string.quoted.docstring.single"
      ],
      "settings": {
        "foreground": "#878D96",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Ace Chemicals Violet \u2014 Keywords & Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other.import",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B695E8"
      }
    },
    {
      "name": "Cryo Sonar \u2014 Operators & Punctuation Separators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.bitwise",
        "keyword.operator.pipe",
        "punctuation.separator.key-value",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#68C5CE"
      }
    },
    {
      "name": "Gordon's Parchment \u2014 Neutral Delimiters & Braces",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.section.block",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#D8D6CF"
      }
    },
    {
      "name": "Oracle Emerald \u2014 Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#63C794"
      }
    },
    {
      "name": "Cryo Sonar \u2014 String Escape & RegExp",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#68C5CE"
      }
    },
    {
      "name": "Ace Chemicals Violet \u2014 Template & f-string Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "constant.character.format.placeholder"
      ],
      "settings": {
        "foreground": "#B695E8"
      }
    },
    {
      "name": "Utility Belt Brass \u2014 Numbers, Booleans & Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other.symbol",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#E29754"
      }
    },
    {
      "name": "Detective Mode \u2014 Functions & Methods",
      "scope": [
        "entity.name.function",
        "entity.name.function.go",
        "entity.name.function.macro.rust",
        "meta.function-call.generic",
        "support.function",
        "support.function.console",
        "support.function.builtin",
        "support.function.macro.rust"
      ],
      "settings": {
        "foreground": "#74AEEB"
      }
    },
    {
      "name": "Ace Chemicals Violet \u2014 Decorators, Go Packages & Python Magic",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "keyword.package.go",
        "keyword.import.go",
        "support.function.magic.python",
        "support.variable.magic.python"
      ],
      "settings": {
        "foreground": "#B695E8"
      }
    },
    {
      "name": "Martha's Pearl \u2014 Language Variables (self, this, super)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#E0A4B8"
      }
    },
    {
      "name": "GCPD Signal \u2014 Classes, Types, Interfaces & Namespaces",
      "scope": [
        "entity.name.type",
        "entity.name.type.go",
        "entity.name.type.rust",
        "entity.name.type.terraform",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "entity.name.lifetime.rust"
      ],
      "settings": {
        "foreground": "#F0C946"
      }
    },
    {
      "name": "Gordon's Parchment \u2014 Variables & Identifiers",
      "scope": [
        "variable",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#D8D6CF"
      }
    },
    {
      "name": "Utility Belt Brass \u2014 Function Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#E29754"
      }
    },
    {
      "name": "Cryo Sonar \u2014 Properties, YAML/JSON Keys & Terraform",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "support.type.property-name.json",
        "support.type.property-name.yaml",
        "entity.name.tag.yaml",
        "entity.name.label.terraform",
        "variable.other.member.terraform",
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#68C5CE"
      }
    },
    {
      "name": "Detective Mode \u2014 HTML/JSX/TSX Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#74AEEB"
      }
    },
    {
      "name": "GCPD Signal \u2014 JSX/TSX Component Tags",
      "scope": [
        "support.class.component"
      ],
      "settings": {
        "foreground": "#F0C946"
      }
    },
    {
      "name": "Utility Belt Brass \u2014 CSS Values & Units",
      "scope": [
        "support.constant.property-value",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#E29754"
      }
    },
    {
      "name": "GCPD Signal \u2014 Dockerfile & Shell Builtins",
      "scope": [
        "keyword.other.special-method.dockerfile",
        "support.function.builtin.shell"
