{
  "theme": {
    "mode": "dark",
    "dark": "Gotham Noir - Year One",
    "light": "Gotham Noir - Year One"
  },
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 14.5,
  "buffer_line_height": {
    "custom": 1.5
  },
  "terminal": {
    "font_family": "Monaspace Neon",
    "font_size": 14.5,
    "font_features": {
      "calt": true,
      "ss01": true,
      "ss02": true,
      "ss03": true,
      "zero": true,
      "cv10": true
    },
    "line_height": {
      "custom": 1.2
    },
    "blinking": "off",
    "cursor_shape": "block",
    "option_as_meta": true,
    "max_scroll_history_lines": 10000
  }
}
